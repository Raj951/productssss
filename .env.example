# Copy to .env.local (git-ignored) and fill in from Supabase:
# Dashboard -> Project Settings -> API Keys (URL is under Data API / "Project URL").
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# For the local stack (npx supabase start) use instead:
# EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<PUBLISHABLE_KEY printed by `npx supabase status`>
